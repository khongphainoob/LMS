# Ví dụ file .env sử dụng cho Frappe LMS (Đọc bởi Docker/Hệ điều hành)
# File này chứa các biến môi trường cấu hình AI an toàn cho hệ thống.
# Frappe sẽ tự động đọc (ưu tiên cấu hình trong .env hoặc site_config trước khi lấy từ DB)

# --- 1. DEFAULT AI PROVIDER ---
DEFAULT_PROVIDER="OpenRouter"
DEFAULT_MODEL="perplexity/pplx-embed-v1-4b"
DEFAULT_API_KEY="sk-or-v1-xxx"
DEFAULT_BASE_URL="https://openrouter.ai/api/v1"

# --- 2. VECTOR DB / RAG (Qdrant) ---
# Nếu sử dụng Qdrant Docker (như cấu hình hiện tại)
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="lms_documents"
EMBEDDING_PROVIDER="OpenRouter"
EMBEDDING_MODEL="perplexity/pplx-embed-v1-4b"

# --- 3. REDIS & MYSQL (Đã có sẵn trong Docker Compose) ---
REDIS_CACHE_URL="redis://localhost:6379/1"
REDIS_QUEUE_URL="redis://localhost:6380/2"

# --- 4. TAVILY SEARCH ---
# API Key cho Web Search Agent
TAVILY_API_KEY="tvly-xxx"

# --- 5. LANGFUSE OBSERVABILITY ---
# Nếu muốn log quá trình suy luận (reasoning trace)
LANGFUSE_PUBLIC_KEY="pk-lf-xxx"
LANGFUSE_SECRET_KEY="sk-lf-xxx"
LANGFUSE_HOST="https://cloud.langfuse.com"
