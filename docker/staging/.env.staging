# Staging environment variables
DB_ROOT_PASSWORD=staging_secure_password
DB_NAME=lms_staging
DB_USER=frappe_staging
DB_PASSWORD=staging_frappe_password

SITE_NAME=staging.lms.yourdomain.com
ADMIN_PASSWORD=staging_admin_password

DEVELOPER_MODE=0
ALLOW_TESTS=1
DEBUG=1

REDIS_CACHE_HOST=redis-cache
REDIS_QUEUE_HOST=redis-queue
REDIS_SOCKETIO_HOST=redis-socketio

# Testing
RUN_E2E_TESTS=1
CYPRESS_BASE_URL=http://staging.lms.yourdomain.com
