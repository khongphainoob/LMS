# Sao chép thành docker/.env rồi sửa. File .env đã nằm trong .gitignore.

# Mật khẩu root của MariaDB. Chỉ dùng trong mạng nội bộ của compose, vẫn nên đổi.
# Phải đặt TRƯỚC lần chạy đầu; đổi sau đó thì xóa volume (docker compose down -v) hoặc sửa tay trong MariaDB.
DB_ROOT_PASSWORD=doi-mat-khau-nay

# Mật khẩu Administrator. Để trống thì init.sh tự sinh ngẫu nhiên, in ra log và lưu ở
# /home/frappe/data/admin_password.txt trong volume.
ADMIN_PASSWORD=

# Cổng trên máy chủ (chỉ bind 127.0.0.1). Đổi nếu 8080 đã bị chiếm.
LMS_PORT=8080

# Chép lại code từ repo vào bench (sau git pull) khi đặt 1. Xem DEMO.md.
RESYNC=0
