{
  "name": "Frappe LMS Demo",
  "dockerComposeFile": "../docker/docker-compose.yml",
  "service": "frappe",
  "runServices": ["frappe", "web"],
  "overrideCommand": false,
  "workspaceFolder": "/lms-src",
  "remoteUser": "frappe",
  "shutdownAction": "stopCompose",
  "forwardPorts": ["web:80"],
  "portsAttributes": {
    "80": {
      "label": "Frappe LMS",
      "onAutoForward": "notify"
    }
  }
}
