{
  "name": "Socratic Session",
  "module": "LMS",
  "doctype": "DocType",
  "is_submittable": 0,
  "field_order": [
    "student",
    "course",
    "batch",
    "lesson",
    "session_key",
    "started_at",
    "last_active",
    "column_break_7",
    "status",
    "flag_reason",
    "teacher_note",
    "document_category",
    "total_tokens",
    "input_tokens",
    "output_tokens",
    "total_cost_usd",
    "message_count",
    "section_break_attachments",
    "attached_image",
    "attached_images",
    "attached_rubric",
    "column_break_learning",
    "knowledge_state",
    "scaffolding_level"
  ],
  "fields": [
    {
      "fieldname": "student",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "label": "Student",
      "in_list_view": 1
    },
    {
      "fieldname": "course",
      "fieldtype": "Link",
      "options": "LMS Course",
      "label": "Course",
      "in_list_view": 1
    },
    {
      "fieldname": "batch",
      "fieldtype": "Link",
      "options": "LMS Batch",
      "label": "Batch",
      "in_list_view": 1
    },
    {
      "fieldname": "lesson",
      "fieldtype": "Link",
      "options": "LMS Lesson",
      "label": "Lesson"
    },
    {
      "fieldname": "session_key",
      "fieldtype": "Data",
      "label": "Redis Session Key",
      "read_only": 1,
      "search_index": 1
    },
    {
      "fieldname": "started_at",
      "fieldtype": "Datetime",
      "label": "Started At",
      "default": "Now"
    },
    {
      "fieldname": "last_active",
      "fieldtype": "Datetime",
      "label": "Last Active"
    },
    {
      "fieldname": "column_break_7",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "Active\nClosed\nBlocked\nFlagged",
      "default": "Active",
      "in_list_view": 1
    },
    {
      "fieldname": "flag_reason",
      "fieldtype": "Small Text",
      "label": "Flag Reason",
      "depends_on": "eval:doc.status=='Flagged'"
    },
    {
      "fieldname": "teacher_note",
      "fieldtype": "Small Text",
      "label": "Teacher Note"
    },
    {
      "fieldname": "document_category",
      "fieldtype": "Link",
      "options": "LMS Document Category",
      "label": "Document Category"
    },
    {
      "fieldname": "total_tokens",
      "fieldtype": "Int",
      "default": 0,
      "label": "Total Tokens Used"
    },
    {
      "fieldname": "input_tokens",
      "fieldtype": "Int",
      "default": 0,
      "label": "Input Tokens"
    },
    {
      "fieldname": "output_tokens",
      "fieldtype": "Int",
      "default": 0,
      "label": "Output Tokens"
    },
    {
      "fieldname": "total_cost_usd",
      "fieldtype": "Float",
      "default": 0,
      "label": "Total Cost USD"
    },
    {
      "fieldname": "message_count",
      "fieldtype": "Int",
      "default": 0,
      "label": "Message Count"
    },
    {
      "fieldname": "duration_seconds",
      "fieldtype": "Float",
      "label": "Duration (seconds)"
    },
    {
      "fieldname": "evaluation_score",
      "fieldtype": "Float",
      "label": "AI Quality Score",
      "description": "1-5 score from content validator"
    },
    {
      "fieldname": "section_break_attachments",
      "fieldtype": "Section Break",
      "label": "Attachments"
    },
    {
      "fieldname": "attached_image",
      "fieldtype": "Attach Image",
      "label": "Attached Image"
    },
    {
      "fieldname": "attached_images",
      "fieldtype": "Long Text",
      "label": "Attached Images JSON"
    },
    {
      "fieldname": "attached_rubric",
      "fieldtype": "Attach",
      "label": "Attached Rubric"
    },
    {
      "fieldname": "column_break_learning",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "knowledge_state",
      "fieldtype": "Code",
      "options": "JSON",
      "label": "Knowledge State (BKT)",
      "description": "Bayesian Knowledge Tracing state"
    },
    {
      "fieldname": "scaffolding_level",
      "fieldtype": "Int",
      "default": 0,
      "label": "Scaffolding Level"
    }
  ],
  "permissions": [
    {
      "role": "LMS Student",
      "read": 1,
      "write": 0
    },
    {
      "role": "Course Creator",
      "read": 1,
      "write": 1,
      "if_owner": 1
    },
    {
      "role": "Moderator",
      "read": 1,
      "write": 1,
      "if_owner": 1
    },
    {
      "role": "Batch Evaluator",
      "read": 1,
      "write": 1,
      "if_owner": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "delete": 1
    },
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "if_owner": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "Instructor",
      "share": 1,
      "write": 1
    }
  ],
  "custom": 0,
  "autoname": "hash"
}