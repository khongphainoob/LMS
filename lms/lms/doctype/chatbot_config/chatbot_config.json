            "share": 1,
            "write": 1
        },
        {
            "create": 1,
            "delete": 1,
            "email": 1,
            "export": 1,
            "if_owner": 1,
            "print": 1,
            "read": 1,
            "report": 1,
            "role": "Instructor",
            "share": 1,
            "write": 1
        },
        {
            "create": 1,
            "delete": 1,
            "email": 1,
            "export": 1,
            "if_owner": 1,
            "print": 1,
            "read": 1,
